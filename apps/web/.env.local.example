# Copia este archivo a .env.local y completa con tus valores reales

# URL pública del backend NestJS (local: http://localhost:3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL del proyecto de Supabase (la misma que en apps/api/.env)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key de Supabase — esta SÍ es segura para exponer en el navegador.
# NUNCA pongas aquí la service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

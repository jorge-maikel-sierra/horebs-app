# Copia este archivo a .env y completa con tus valores reales de Supabase
# (Project Settings → API en el panel de Supabase)

PORT=3000

# URL del proyecto de Supabase, ej: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service Role Key — tiene privilegios completos, SOLO usar en el backend.
# Nunca la expongas en el frontend ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# URL del frontend desplegado (para CORS). En local: http://localhost:3001
FRONTEND_URL=http://localhost:3001
